{
    "name": "@domageddon/site-crawler",
    "version": "1.0.0",
    "description": "",
    "license": "UNLICENSED",
    "author": "tmkn",
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/main.ts",
            "default": "./build/src/main.js"
        }
    },
    "scripts": {
        "build": "tsc --build",
        "dev": "tsc --build --watch",
        "scraper:dev": "nodemon --watch build/src --watch ../../packages/dom-extractor/dist build/src/playground.js",
        "test": "vitest --run",
        "test:coverage": "vitest --run --coverage",
        "typecheck": "tsc --build",
        "typecheck:watch": "tsc --build --watch"
    },
    "dependencies": {
        "@domageddon/dom-extractor": "workspace:*",
        "playwright": "^1.62.1"
    },
    "devDependencies": {
        "@tooling/tsconfig": "workspace:*",
        "@tooling/vitest": "workspace:*"
    }
}
