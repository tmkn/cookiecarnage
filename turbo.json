{
    "$schema": "https://v2-10-12.turborepo.dev/schema.json",
    "ui": "tui",
    "tasks": {
        "build": {
            "outputs": ["build/**"],
            "dependsOn": ["^build"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "typecheck": {
            "outputs": ["build/**"]
        },
        "typecheck:watch": {
            "cache": false,
            "persistent": true
        },
        "test": {},
        "test:coverage": {},
        "scraper:dev": {},
        "website:dev": {}
    }
}
