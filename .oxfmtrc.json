{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "arrowParens": "avoid",
    "bracketSpacing": true,
    "htmlWhitespaceSensitivity": "css",
    "bracketSameLine": false,
    "jsxSingleQuote": false,
    "proseWrap": "preserve",
    "quoteProps": "as-needed",
    "semi": true,
    "singleQuote": false,
    "tabWidth": 4,
    "trailingComma": "none",
    "useTabs": false,
    "printWidth": 100,
    "sortPackageJson": {
        "sortScripts": true
    },
    "ignorePatterns": [],
    "sortImports": true,
    "embeddedLanguageFormatting": "auto",
    "sortTailwindcss": true
}
